# Repository workspace (required)
STELLAR_REPO_ROOT=
# Legacy alias: IMPACTLENS_REPO_ROOT=

# Entire is mandatory for the product path.
# Install/activate using the commands in docs/entire-workflow.md.

# Databricks data plane (required for the Databricks award path)
DATABRICKS_ENABLED=true
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=
DATABRICKS_AI_SEARCH_ENDPOINT=
DATABRICKS_AI_SEARCH_INDEX=
DATABRICKS_EMBEDDING_MODEL=

# Model Serving / OpenAI-compatible endpoint
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=1800

# Optional explicit fallback for a recorded/local test only. Keep false for judging.
STELLAR_ALLOW_LOCAL_FALLBACK=false
ALLOW_UNVERIFIED_LLM_FALLBACK=false

# Optional private Git access; never commit this value.
GIT_TOKEN=

# Optional frontend origins; empty means same-origin only.
CORS_ORIGINS=

# Optional API protection for a deployed backend.
STELLAR_API_KEY=

# Firebase Authentication (Web App Configuration)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Core
ANTHROPIC_API_KEY=

# Real Entire Graph + Checkpoints
# Requires Entire CLI >= 0.10 and Entire Graph plugin.
ENTIRE_ENABLED=false

# Databricks SQL Warehouse
DATABRICKS_ENABLED=false
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=impactlens

# Existing Databricks AI Search index (Delta Sync index recommended)
DATABRICKS_WORKSPACE_URL=https://<workspace-host>
DATABRICKS_AI_SEARCH_ENDPOINT=
DATABRICKS_AI_SEARCH_INDEX=main.impactlens.checkpoint_index

# Maximum Databricks mode
DATABRICKS_WORKSPACE_URL=https://<workspace>.cloud.databricks.com
DATABRICKS_LLM_ENABLED=false
DATABRICKS_LLM_ENDPOINT=<model-serving-endpoint-name>
DATABRICKS_EMBEDDING_MODEL=databricks-gte-large-en
MLFLOW_ENABLED=false

# Real repository import (optional; needed for private HTTPS repositories)
GIT_TOKEN=

# Local development: allow analyzing real repositories under this directory.
# Example: IMPACTLENS_REPO_ROOT=/home/you/projects
IMPACTLENS_REPO_ROOT=
